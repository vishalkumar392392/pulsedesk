{
  "info": {
    "_postman_id": "6a1cc6a7-8166-4afb-9240-91785c51db5f",
    "name": "PulseDesk API",
    "description": "Import this collection together with the PulseDesk Local environment. Select the environment, update loginEmail/loginPassword, and run Auth > Login first. All protected requests inherit the collection-level Authorization: Bearer {{accessToken}} configuration. Successful login, create, and list requests automatically save useful tokens and resource IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:80", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "loginEmail", "value": "admin@pd.com", "type": "string" },
    { "key": "loginPassword", "value": "password", "type": "string" },
    { "key": "currentUserId", "value": "1", "type": "string" },
    { "key": "page", "value": "0", "type": "string" },
    { "key": "pageSize", "value": "25", "type": "string" },
    { "key": "ticketId", "value": "1", "type": "string" },
    { "key": "assigneeId", "value": "1", "type": "string" },
    { "key": "ticketStatus", "value": "IN_PROGRESS", "type": "string" },
    { "key": "ticketStatusFilter", "value": "OPEN", "type": "string" },
    { "key": "ticketPriorityFilter", "value": "HIGH", "type": "string" },
    { "key": "ticketSort", "value": "createdAt", "type": "string" },
    { "key": "sortDirection", "value": "desc", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "userEmail", "value": "admin@pd.com", "type": "string" },
    { "key": "userRoleFilter", "value": "employee", "type": "string" },
    { "key": "userSort", "value": "name", "type": "string" },
    { "key": "assetId", "value": "1", "type": "string" },
    { "key": "assetAssigneeId", "value": "1", "type": "string" },
    { "key": "assetStatusFilter", "value": "IN_STOCK", "type": "string" },
    { "key": "assetTypeFilter", "value": "LAPTOP", "type": "string" },
