          "name": "Assign Asset",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": {{assetAssigneeId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/assets/:assetId/assign",
              "host": ["{{baseUrl}}"],
              "path": ["assets", ":assetId", "assign"],
              "variable": [
                { "key": "assetId", "value": "{{assetId}}", "description": "Asset ID" }
              ]
            },
            "description": "Agent or admin. Assigns the asset to an active user."
          }
        },
        {
          "name": "Unassign Asset",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/assets/:assetId/assign",
              "host": ["{{baseUrl}}"],
              "path": ["assets", ":assetId", "assign"],
              "variable": [
                { "key": "assetId", "value": "{{assetId}}", "description": "Asset ID" }
              ]
            },
            "description": "Agent or admin. Removes the current asset assignment."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "All operations are automatically scoped to the authenticated user.",
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const notifications = pm.response.json().data.content || [];",
                  "  if (notifications.length) {",
                  "    pm.environment.set('notificationId', String(notifications[0].id));",
                  "    pm.environment.set('ticketId', String(notifications[0].ticketId));",
                  "    pm.environment.set('commentId', String(notifications[0].commentId));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications?page={{page}}&size={{pageSize}}&unreadOnly={{unreadOnly}}",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [
                { "key": "page", "value": "{{page}}", "description": "Zero-based page number" },
                { "key": "size", "value": "{{pageSize}}", "description": "Page size, maximum 100" },
                { "key": "unreadOnly", "value": "{{unreadOnly}}", "description": "true to return unread notifications only" }
              ]
            },
            "description": "Returns notifications newest first and saves notificationId, ticketId, and commentId from the first result."
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread-count"]
            },
            "description": "Returns the authenticated user's unread notification count."
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/:notificationId/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", ":notificationId", "read"],
              "variable": [
                { "key": "notificationId", "value": "{{notificationId}}", "description": "Notification ID owned by the current user" }
              ]
            },
            "description": "Returns 204. Returns 404 if the notification is not owned by the authenticated user."
          }
        },
        {
          "name": "Mark Ticket Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/ticket/:ticketId/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "ticket", ":ticketId", "read"],
              "variable": [
                { "key": "ticketId", "value": "{{ticketId}}", "description": "Ticket ID" }
              ]
            },
            "description": "Returns 204. Marks the authenticated user's comment notifications for this ticket as read."
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read-all"]
            },
            "description": "Returns 204. Marks all notifications owned by the authenticated user as read."
          }
        }
      ]
    },
