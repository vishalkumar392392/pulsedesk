  "item": [
    {
      "name": "Auth",
      "description": "JWT authentication. Login and refresh requests do not send a Bearer token.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  const data = response.data;",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  if (data.user && data.user.id) {",
                  "    pm.environment.set('currentUserId', String(data.user.id));",
                  "    pm.collectionVariables.set('currentUserId', String(data.user.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a user. The test script saves accessToken, refreshToken, and currentUserId in both the selected environment and the collection fallback variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refreshToken",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refreshToken"]
            },
            "description": "Generates and saves a new access/refresh token pair."
          }
        },
        {
          "name": "Register User (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const user = pm.response.json().data;",
                  "  pm.environment.set('userId', String(user.id));",
                  "  pm.environment.set('userEmail', user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Employee\",\n  \"email\": \"postman.employee+{{$timestamp}}@example.com\",\n  \"mobileNumber\": \"9999999999\",\n  \"pwd\": \"password\",\n  \"role\": \"employee\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Admin only. Creates a user and saves the returned userId and userEmail. Valid roles: admin, agent, employee."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "User management. List, lookup, and update operations require an admin token; profile/password endpoints work for the current authenticated user.",
      "item": [
        {
          "name": "List Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const users = pm.response.json().data.content || [];",
                  "  if (users.length) {",
                  "    pm.environment.set('userId', String(users[0].id));",
                  "    pm.environment.set('userEmail', users[0].email);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/all?page={{page}}&size={{pageSize}}&sort={{userSort}}&direction={{sortDirection}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "all"],
              "query": [
                { "key": "page", "value": "{{page}}", "description": "Zero-based page number" },
                { "key": "size", "value": "{{pageSize}}", "description": "Page size, maximum 100" },
                { "key": "role", "value": "{{userRoleFilter}}", "description": "Optional: admin, agent, or employee", "disabled": true },
                { "key": "sort", "value": "{{userSort}}", "description": "name, email, role, status, or create_dt" },
                { "key": "direction", "value": "{{sortDirection}}", "description": "asc or desc" }
              ]
            },
            "description": "Admin only. Returns a paginated user list and saves the first returned user's identifiers."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/id/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["user", "id", ":userId"],
              "variable": [
                { "key": "userId", "value": "{{userId}}", "description": "PulseDesk user ID" }
              ]
            },
            "description": "Admin only."
          }
        },
        {
          "name": "Get User by Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/email/:email",
              "host": ["{{baseUrl}}"],
              "path": ["user", "email", ":email"],
              "variable": [
                { "key": "email", "value": "{{userEmail}}", "description": "User email address" }
              ]
            },
            "description": "Admin only. Postman URL-encodes the email path variable."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"employee\",\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["user", ":userId"],
              "variable": [
                { "key": "userId", "value": "{{userId}}", "description": "User ID to update" }
              ]
            },
            "description": "Admin only. Valid status values: ACTIVE, INACTIVE. Valid roles: admin, agent, employee."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Profile Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/user/me/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "me", "profile"]
            },
            "description": "Updates the authenticated user's display name."
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password\",\n  \"newPassword\": \"new-password\",\n  \"confirmPassword\": \"new-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/user/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["user", "me", "password"]
            },
            "description": "Changes the authenticated user's password. Update loginPassword after this request if you intend to log in again."
          }
        }
      ]
    },
    {
